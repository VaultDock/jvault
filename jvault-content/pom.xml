<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.jvault</groupId>
    <artifactId>jvault-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jvault-content</artifactId>
  <name>jvault-content</name>
  <description>
    The composition layer: resolves placement, stores external content encrypted, builds the
    Jira-safe payload from surrogates, and enqueues the outbox effects. This is where the
    "one behaviour, three entry points" promise is actually kept — UI, REST and Kafka are all
    thin adapters over this (docs/03-architecture.md 3.5).
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-jira</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-outbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-crypto</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        The in-memory repositories in src/test are reproductions of contract properties the real
        adapters get from database constraints. Publishing them as a test-jar lets downstream
        modules reuse them rather than growing a third divergent copy — and a fake that drifts
        from the contract is worse than no fake at all.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
