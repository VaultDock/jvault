<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.jvault</groupId>
    <artifactId>jvault-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jvault-storage</artifactId>
  <name>jvault-storage</name>
  <description>
    The pluggable content store: the SPI, capability negotiation, and the filesystem backend
    (docs/08-storage.md). Decision D2 makes filesystem a production backend, not a development
    convenience.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Test scope only. Encryption sits above the store and the store knows nothing about it;
      this dependency exists purely so their composition can be tested end to end, which is
      where the property that matters lives — a backend operator must learn nothing from the
      bytes on disk.
    -->
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-crypto</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
