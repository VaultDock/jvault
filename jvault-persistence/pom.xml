<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.jvault</groupId>
    <artifactId>jvault-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jvault-persistence</artifactId>
  <name>jvault-persistence</name>
  <description>
    JDBC adapters for the persistence ports, across PostgreSQL, Microsoft SQL Server and Oracle
    (decision D5). Everything portable lives in shared code; the statements that genuinely cannot
    be portable are isolated in SqlDialect and named as such.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-outbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Persistence is an adapter for the ports these modules declare: it depends on them, and
         nothing depends on it except the composition root. -->
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-content</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-authz</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-crypto</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <!--
      Spring JDBC rather than jOOQ. jOOQ is the better multi-dialect SQL library on the merits,
      but its Open Source Edition is Apache-2.0 only for open-source databases: Oracle and SQL
      Server require a commercial licence (jooq.org/legal/licensing), and decision D5 puts both
      in scope. Spring JDBC carries the same licence as the rest of the stack, costs nothing per
      engine, and — importantly — does not try to generate the dequeue SQL, which is the one
      thing that must stay visible. Its exception translation also removes the per-dialect
      duplicate-key detection we would otherwise hand-write three times.
    -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>

    <!--
      JDBC drivers are optional: a deployment brings the one it needs. Bundling all three would
      drag Oracle's driver into every build for no benefit, and the commercial drivers have
      licence terms a deployer should opt into knowingly.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- Test scope: PostgreSQL is the dialect this repository verifies against a real engine. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.16</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
