<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.jvault</groupId>
    <artifactId>jvault-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>jvault-api</artifactId>
  <name>jvault-api</name>
  <description>
    The HTTP entry point: the versioned REST API and the permanent content link
    (docs/06-rest-api.md). A thin adapter over the application core — the same core the Kafka
    consumer uses — so that behaviour cannot diverge between entry points.
  </description>

  <dependencies>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-content</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-authz</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- The composition root is the one place that may know about an adapter. Nothing else in
         this module imports from dev.jvault.persistence, and an architecture test says so. -->
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- The runnable application is a deployment, so it brings its own engine support: the
         JDBC driver and the Flyway module that recognises the engine. jvault-persistence
         deliberately declares neither, so that an Oracle deployment does not drag PostgreSQL
         along and vice versa. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>dev.jvault</groupId>
      <artifactId>jvault-content</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring.boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
